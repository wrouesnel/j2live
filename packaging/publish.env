# Publication settings, sourced by the publish scripts. Override any of these
# in the environment.

# The shared key that signs all Launchpad PPA uploads ("Will Rouesnel (GPG key
# for launchpad signing)"), registered on the ~w-rouesnel Launchpad account.
# Its passphrase is looked up with:
#   secret-tool lookup service gpg-passphrase fingerprint <fingerprint>
J2LIVE_SIGNING_KEY="${J2LIVE_SIGNING_KEY:-2A128435A6FE8BD751AA578720959AB807096ADB}"

# Launchpad PPA for the Ubuntu packages
PPA="${PPA:-ppa:w-rouesnel/j2live}"

# COPR project for the RHEL packages, as [owner/]project
COPR_PROJECT="${COPR_PROJECT:-j2live}"
COPR_ARCHES="${COPR_ARCHES:-x86_64}"
